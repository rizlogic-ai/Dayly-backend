# Server
PORT=4000

# Postgres connection string.
# Local dev default matches this machine's existing Postgres instance
# (server: localhost, port: 5433, user: postgres) — just swap in the
# password and use a dedicated "dayly" database so this never touches
# other projects' data.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/dayly

# Optional. SSL is auto-detected from DATABASE_URL (off for
# localhost/127.0.0.1, on otherwise — Render Postgres needs it). Only set
# this to override that guess: "true" or "false".
# PGSSL=true

# Optional. Comma-separated allowed origins for CORS. Unset = allow any
# origin, which is fine while every client is the mobile app (Bearer
# auth, no cookies). Set this once a browser-based client exists.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com

# Firebase Admin credentials, from your Firebase project's
# Project Settings > Service Accounts > Generate new private key (do NOT
# commit the downloaded JSON file). Two ways to supply them:
#
# PREFERRED, especially for Render/any hosted env-var UI — base64 the
# entire downloaded JSON into one line (no newlines/quotes for the
# platform to mangle):
#   node -e "console.log(Buffer.from(require('fs').readFileSync('serviceAccountKey.json')).toString('base64'))"
# FIREBASE_SERVICE_ACCOUNT_BASE64=<paste the output here>
#
# Fallback for local dev (faster to hand-edit than regenerating base64
# every time) — three discrete vars. Keep the quotes and literal \n
# sequences exactly as they appear in the downloaded JSON's private_key
# field. Ignored if FIREBASE_SERVICE_ACCOUNT_BASE64 is set.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
